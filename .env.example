# Publish-tree configuration template. Copy to .env and fill in local values.
# Do not put production secrets, personal networks, or live hostnames here.
# A missing required egress setting fail-closes overseas traffic; it does not fall back to a baked-in proxy or IP.

# Project root. If empty, services look upward from this file for package.json.
PROJECT_ROOT=

# Listen address for HTTP services in this tree. Default is loopback.
# Set to 0.0.0.0 only when you intentionally expose a port (for example behind a local reverse proxy).
LISTEN_HOST=127.0.0.1

# Egress proxy for overseas model/API traffic. Required for those paths. Examples: http://127.0.0.1:1088
# Aliases still read: CLAUDE_OAUTH_PROXY, AIRPORT_PROXY
EGRESS_PROXY=

# Expected public egress IP after the proxy. Required. If the probe sees a different IP, the request is blocked.
# Alias still read: CLAUDE_EGRESS_EXPECT_IP
EGRESS_EXPECT_IP=

# Optional vendor-container integration (reconnect / status). Leave empty to disable auto-reconnect and container control.
# This is optional integration, not a required default. Do not put a production node id here unless you mean to.
EGRESS_KEEPER_CONTAINER=
EGRESS_KEEPER_NODE=
EGRESS_KEEPER_INTERVAL_MS=300000

# Optional airport/mihomo integration paths. Leave empty to disable that integration.
AIRPORT_YAML=
AIRPORT_URL_FILE=
MIHOMO_BIN=
MIHOMO_HOME=

# OAuth token storage. If empty, defaults to $PROJECT_ROOT/data/oauth
OAUTH_TOKEN_DIR=
OAUTH_MARK_DIR=
CLAUDE_TOKEN_FILE=

# Official / documented public OAuth client identifiers. Leave blank to disable that provider's OAuth in this instance.
# Gemini: documented official Gemini CLI public client (Google Cloud project number 681255809395).
# Fill the officially published client_id and installed-app client_secret yourself. This file does not ship those values.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Antigravity: earlier in-tree comments described an official desktop client (project number 1071006060591).
# This batch did not independently re-verify that claim. Fill in only confirmed official published values.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Other CLI public client IDs (no personal secrets). Leave blank to disable.
CLAUDE_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_ID=
GROK_OAUTH_CLIENT_ID=

# Public base URL of this deployment if you serve it behind a hostname. Example: http://127.0.0.1:3000
# Do not use a production personal domain as a default.
PUBLIC_BASE_URL=
WORLD_URL=

# Extra hostnames treated as "this machine" for local MCP classification, comma-separated. localhost is always included.
LOCAL_MCP_HOSTS=

# Optional default playlist id for the Netease add-to-playlist helper. Empty disables the hard-coded target.
NETEASE_PLAYLIST_ID=

# Log sentinel: comma-separated MCP path-password segments. Empty means that detector matches nothing (it does not fall back to old values).
MCP_PATH_SECRETS=
# Comma-separated CIDR prefixes or dotted prefixes considered "known". Empty means no personal/network allowlist is baked in.
SENTINEL_KNOWN_IP_PREFIXES=
SENTINEL_STATE_DIR=
BARK_ENV_FILE=
SENTINEL_EVENTS_FILE=

# Optional paths
WAKE_UP_LOG_PATH=
GATEWAY_CALLBACK_URL=http://127.0.0.1:3000

# Optional path to MCP secrets file (key=value). Empty uses $PROJECT_ROOT/config/mcp-secrets.env (do not commit that file).
MCP_SECRETS_FILE=

# Optional world page root. Empty uses $PROJECT_ROOT/little-world/apps/world
WORLD_ROOT=

# Display names for context/push helpers. Leave blank to fall back to
# config/chat-settings.json (theme page user_name / ai_name), then defaults "用户" / "助手".
USER_DISPLAY_NAME=
AI_DISPLAY_NAME=
